@model WebAlunos.Models.Aluno

@{
    ViewBag.Title = "Criar Aluno";
}

<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>

    <!-- Bootstrap CSS via CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
</head>
<body>

    <div class="container mt-5">
        <div class="card shadow-lg">
            <div class="card-header bg-primary text-white">
                <h3 class="mb-0">Criar Novo Aluno</h3>
            </div>
            <div class="card-body">
                @using (Html.BeginForm("CriaAluno", "Aluno", FormMethod.Post, new { enctype = "multipart/form-data", @class = "needs-validation", novalidate = "novalidate" }))
                {
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                @Html.LabelFor(model => model.NAluno, "Número do Aluno", new { @class = "form-label fw-bold" })
                                @Html.EditorFor(model => model.NAluno, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                                @Html.ValidationMessageFor(model => model.NAluno, "", new { @class = "text-danger" })
                            </div>

                            <div class="mb-3">
                                @Html.LabelFor(model => model.PrimeiroNome, "Primeiro Nome", new { @class = "form-label fw-bold" })
                                @Html.EditorFor(model => model.PrimeiroNome, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                                @Html.ValidationMessageFor(model => model.PrimeiroNome, "", new { @class = "text-danger" })
                            </div>

                            <div class="mb-3">
                                @Html.LabelFor(model => model.UltimoNome, "Último Nome", new { @class = "form-label fw-bold" })
                                @Html.EditorFor(model => model.UltimoNome, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                                @Html.ValidationMessageFor(model => model.UltimoNome, "", new { @class = "text-danger" })
                            </div>

                            <div class="mb-3">
                                @Html.LabelFor(model => model.Morada, "Morada", new { @class = "form-label fw-bold" })
                                @Html.EditorFor(model => model.Morada, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Morada, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                @Html.LabelFor(model => model.DataNascimento, "Data de Nascimento", new { @class = "form-label fw-bold" })
                                <input type="date" name="DataNascimento" class="form-control" required>
                                @Html.ValidationMessageFor(model => model.DataNascimento, "", new { @class = "text-danger" })
                            </div>

                            <div class="mb-3">
                                @Html.LabelFor(model => model.AnoEscolaridade, "Ano Escolaridade", new { @class = "form-label fw-bold" })
                                @Html.EditorFor(model => model.AnoEscolaridade, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                                @Html.ValidationMessageFor(model => model.AnoEscolaridade, "", new { @class = "text-danger" })
                            </div>

                            <div class="mb-3">
                                @Html.LabelFor(model => model.Imagem, "Foto do Aluno", new { @class = "form-label fw-bold" })
                                <input type="file" name="Imagem" class="form-control">
                                @Html.ValidationMessageFor(model => model.Imagem, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="text-center mt-4">
                        <button type="submit" class="btn btn-success btn-lg"><i class="fas fa-save"></i> Criar Aluno</button>
                        @Html.ActionLink("Voltar à Lista", "ListaAluno", null, new { @class = "btn btn-secondary btn-lg" })
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
