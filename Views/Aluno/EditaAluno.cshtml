@model WebAlunos.Models.Aluno
@using WebAlunos.Models

@{
    ViewBag.Title = "Editar Aluno";
}

<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
</head>
<body>

    <div class="container mt-5">
        <div class="card shadow-lg">
            <div class="card-header bg-primary text-white text-center">
                <h3>Editar Aluno</h3>
            </div>
            <div class="card-body">
                @using (Html.BeginForm("EditaAluno", "Aluno", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(model => model.NAluno)

                    <div class="row mb-3">
                        <label class="col-sm-3 col-form-label fw-bold">Primeiro Nome</label>
                        <div class="col-sm-9">
                            @Html.EditorFor(model => model.PrimeiroNome, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.PrimeiroNome, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-3 col-form-label fw-bold">Último Nome</label>
                        <div class="col-sm-9">
                            @Html.EditorFor(model => model.UltimoNome, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.UltimoNome, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-3 col-form-label fw-bold">Morada</label>
                        <div class="col-sm-9">
                            @Html.EditorFor(model => model.Morada, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Morada, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-3 col-form-label fw-bold">Sexo</label>
                        <div class="col-sm-9">
                            @Html.DropDownListFor(model => model.Sexo, new SelectList(Enum.GetValues(typeof(Sexo))), new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.Sexo, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-3 col-form-label fw-bold">Data de Nascimento</label>
                        <div class="col-sm-9">
                            @Html.EditorFor(model => model.DataNascimento, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.DataNascimento, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-3 col-form-label fw-bold">Ano Escolaridade</label>
                        <div class="col-sm-9">
                            @Html.EditorFor(model => model.AnoEscolaridade, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.AnoEscolaridade, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-3 col-form-label fw-bold">Imagem Atual</label>
                        <div class="col-sm-9 text-center">
                            @if (!string.IsNullOrEmpty(Model.ImagePath))
                            {
                                <img src="@Url.Content(Model.ImagePath)" class="img-fluid rounded border shadow-sm" alt="Imagem do aluno" style="max-width: 150px;">
                            }
                            else
                            {
                                <p class="text-muted fst-italic">Sem imagem disponível</p>
                            }
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-3 col-form-label fw-bold">Nova Imagem</label>
                        <div class="col-sm-9">
                            <input type="file" name="Imagem" class="form-control">
                        </div>
                    </div>

                    <div class="text-center">
                        <button type="submit" class="btn btn-success me-2">Guardar</button>
                        @Html.ActionLink("Voltar à Lista", "ListaAluno", null, new { @class = "btn btn-secondary" })
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
